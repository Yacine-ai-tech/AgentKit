{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://gateway.ysiddo-ai-projects.app/agentkit/docs"
    },
    {
      "source": "/docs/(.*)",
      "destination": "https://gateway.ysiddo-ai-projects.app/agentkit/docs/$1"
    },
    {
      "source": "/openapi.json",
      "destination": "https://gateway.ysiddo-ai-projects.app/agentkit/openapi.json"
    },
    {
      "source": "/((?!.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|json|woff2?|webmanifest)).*)",
      "destination": "/index.html"
    }
  ]
}
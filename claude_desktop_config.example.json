{
  "mcpServers": {
    "agentkit": {
      "command": "python",
      "args": [
        "-m",
        "agentkit_mcp.mcp_server"
      ],
      "env": {
        "PYTHONPATH": "/path/to/AgentKit/src",
        "POSTGRES_URL": "postgresql://user:password@localhost/neondb?sslmode=require"
      }
    }
  }
}

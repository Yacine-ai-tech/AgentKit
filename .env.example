POSTGRES_URL=postgresql://user:password@localhost/dbname
LLM_ENDPOINT=https://api.openai.com/v1
LLM_TOKEN=your_api_token
# Shared secret for internal service-to-service auth via the X-OmniIntel-Internal-Token header, must match the value configured on the gateway and all other OmniIntel services
OMNIINTEL_INTERNAL_TOKEN=

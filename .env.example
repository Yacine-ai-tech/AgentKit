# AgentKit — MCP server for business intelligence
# Copy to .env and fill in your real keys

# Database Configuration
POSTGRES_URL=postgresql://agentkit:change_me@localhost:5432/agentkit

# LLM Models
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_REASONING=anthropic/claude-sonnet-4-6
LLM_JUDGE=anthropic/claude-haiku-4-5
LLM_LOCAL=ollama/llama3.3

# API Keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8005,http://localhost:3000
OMNIINTEL_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false

# Logging & Telemetry
LOG_LEVEL=INFO
TELEMETRY_OPT_OUT=false

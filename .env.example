POSTGRES_URL=postgresql://user:password@localhost/dbname
LLM_ENDPOINT=https://api.openai.com/v1
LLM_TOKEN=your_api_token
# Shared secret for internal service-to-service auth via the X-OmniIntel-Internal-Token header, must match the value configured on the gateway and all other OmniIntel services
OMNIINTEL_INTERNAL_TOKEN=

# Anonymous startup ping (service name + a random, locally-generated, non-hardware-derived
# install ID — see TELEMETRY.md for exactly what's sent). Set to true to disable entirely.
TELEMETRY_OPT_OUT=false
# Where the ping goes. Defaults to the upstream AgentKit project's adoption-tracking
# endpoint; override or leave OPT_OUT=true if you don't want to report to it.
TELEMETRY_URL=https://gateway.ysiddo-ai-projects.app/telemetry

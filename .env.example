# AgentKit example environment — copy to .env and fill in.

# ── Database ─────────────────────────────────────────────────────────────────
# The tools (query_kpis, get_company_health, detect_kpi_anomalies, ...) read from
# whatever Postgres this points at. Seed it with src/agentkit_mcp/db/schema.sql
# (or `python -m src.data.seed` for synthetic demo data) — see SELF_HOSTING.md.
POSTGRES_URL=postgresql://user:password@localhost/dbname

# ── MCP server auth (required) ────────────────────────────────────────────────
# Bearer token gating the /sse endpoint (Authorization: Bearer <token>). The
# server refuses to start over SSE without one set — pick any random string
# for local dev; use a real secret in production.
MCP_AUTH_TOKEN=change_this_to_a_random_string
# sse (default, serves /sse + the REST facade over HTTP — for a deployed/shared
# instance) | stdio (JSON-RPC over stdin/stdout — for Claude Desktop/Cursor/Devin
# spawning this process directly; no network port, no MCP_AUTH_TOKEN needed).
MCP_TRANSPORT=sse
# Port for the combined SSE + REST facade server.
MCP_PORT=8005

# ── LLM providers (multi-provider via LiteLLM — set the key(s) for whichever
# provider(s) the model strings below reference) ──────────────────────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per-role model routing used by workflow.py's 3-agent LangGraph pipeline
# (planner/reporter use LLM_REASONING, the tool-calling analyst uses LLM_DEFAULT)
# and by the demos/research scripts. Any LiteLLM-style "provider/model" string
# works — swap providers here, no code changes needed.
LLM_DEFAULT=groq/openai/gpt-oss-120b
LLM_REASONING=anthropic/claude-sonnet-4-6
LLM_JUDGE=anthropic/claude-haiku-4-5

# ── Self-hosted / local inference (no third-party provider) ──────────────────
# "local" means inference on hardware YOU control — this machine, your own GPU box,
# or a shared inference host you run. Never assumed to be the only option, and never
# assumed to be localhost: it's entirely env-driven, so the same code covers all of them.
#
#   INFERENCE_MODE=remote  (default)  use the hosted tier models above
#   INFERENCE_MODE=local              force EVERY tier to LLM_LOCAL — no hosted
#                                     provider is contacted, no provider key needed
INFERENCE_MODE=remote

# The model, in LiteLLM "provider/model" form. IMPORTANT — the prefix picks the wire
# protocol, so match it to what your endpoint actually implements:
#   ollama_chat/<model>  -> POSTs {endpoint}/api/chat       (Ollama's native chat route)
#   ollama/<model>       -> POSTs {endpoint}/api/generate   (Ollama's completion route)
LLM_LOCAL=ollama_chat/qwen2.5

# Where that model runs. Leave BLANK to use LiteLLM's default (http://localhost:11434).
# Set it to point anywhere — pick the line matching your setup:
#   Ollama on this machine ....... http://localhost:11434      (needs a local GPU)
#   Your own GPU box on the LAN ... http://192.168.1.50:11434
#   A shared inference host ....... https://your-inference-host.example
#   vLLM / llama.cpp / LM Studio .. whatever base URL it serves on
# NOTE: give the BASE URL only — do NOT include a trailing "/api". LiteLLM appends the
# protocol path itself, so ".../api" becomes ".../api/api/chat" and 404s.
LOCAL_LLM_ENDPOINT=

# Bearer token for that endpoint, if it needs one. A bare Ollama on localhost does not;
# anything shared or exposed beyond your LAN will.
LOCAL_LLM_TOKEN=

# Resilience: if a HOSTED call fails (outage, rate limit, bad key, network), retry once
# against LLM_LOCAL instead of erroring. Off by default — silently serving a
# lower-quality model is a tradeoff the operator should opt into deliberately.
LLM_FALLBACK_TO_LOCAL=false

# ── Internal service auth / self-hosting ────────────────────────────────────
# Optional shared secret for internal service-to-service auth via the
# X-AgentKit-Internal-Token header. Only needed if you set REQUIRE_INTERNAL_TOKEN=true.
AGENTKIT_INTERNAL_TOKEN=
# When true, every REST facade route except /health, /docs, and static assets
# requires a matching X-AgentKit-Internal-Token header. Standalone self-hosting
# (no gateway in front) should leave this false (the default).
REQUIRE_INTERNAL_TOKEN=false

# ── Capability Policy ─────────────────────────────────────────────────────────
# AGENTKIT_ALLOW_WRITES — must be explicitly set to true to enable any tool with
# effect=write or effect=destructive. Default is false: a fresh install exposed to
# the internet cannot mutate anything.
AGENTKIT_ALLOW_WRITES=false

# Scopes granted to callers on this deployment. Tools declare required scopes;
# callers without the required scope are denied. Grant "*" only for trusted local use.
AGENTKIT_SCOPES=

# Human-held approval token for destructive operations. The model never has this —
# a human or supervising system supplies it per-call. If unset and a destructive
# tool is invoked, the call is denied (fails closed).
AGENTKIT_APPROVAL_TOKEN=

# Path for the JSON Lines audit trail. All invocations (allowed and denied) are
# written here. Leave blank to disable durable logging (in-memory only).
AGENTKIT_AUDIT_LOG=

# ── Logging & Telemetry ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Anonymous startup ping (service name + random install ID, no personal data).
# Set TELEMETRY_OPT_OUT=true to disable. Set TELEMETRY_URL to route to your own
# telemetry endpoint; leave blank to disable telemetry entirely.
TELEMETRY_OPT_OUT=false
TELEMETRY_URL=

# AgentKit configuration. Copy to `.env` and fill in what you use. Every value is read from the
# environment; nothing is hardcoded. Empty means "unset". Never commit a filled-in copy.

# ─── Server ──────────────────────────────────────────────────────────────────
# Transport: sse (HTTP server with the REST facade) or stdio (spawned by an MCP client). Default:
# sse when a port is set, stdio otherwise.
MCP_TRANSPORT=sse
# Port for the combined SSE + REST facade server (PORT is accepted too). Default 8005.
MCP_PORT=8005
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Python logging format string.
# LOG_FORMAT=

# ─── Access control ──────────────────────────────────────────────────────────
# Bearer token required on the SSE endpoint (Authorization: Bearer <token>). Use a long random
# value. Unset disables SSE auth (development only).
MCP_AUTH_TOKEN=
# Requests per client address per window on the SSE endpoint (default 120 per 60 seconds).
MCP_RATE_LIMIT=120
MCP_RATE_WINDOW=60
# When true, every REST facade route under /api requires an internal token header
# (X-AgentKit-Internal-Token, X-Internal-Token or X-OmniIntel-Internal-Token).
REQUIRE_INTERNAL_TOKEN=false
# Token(s) accepted when REQUIRE_INTERNAL_TOKEN=true. Any one is enough.
AGENTKIT_INTERNAL_TOKEN=
INTERNAL_TOKEN=
OMNIINTEL_INTERNAL_TOKEN=
# Secret presented in X-Admin-Token to read the audit trail across sessions.
ADMIN_TOKEN=
# Secret from which the key protecting stored credentials is derived. Falls back to the internal
# token, MCP_AUTH_TOKEN, then POSTGRES_URL. Set a dedicated value in production.
SECRET_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection URL for KPI data and annotations (DATABASE_URL is accepted too).
# Create the schema with src/agentkit_mcp/db/schema.sql or seed demo data with
# `python -m agentkit_mcp.data.seed`.
POSTGRES_URL=

# ─── Capability policy ───────────────────────────────────────────────────────
# Enables tools whose effect is write or destructive. Default false: nothing can mutate.
AGENTKIT_ALLOW_WRITES=false
# Scopes granted to callers on this deployment: comma-separated list, or * for all (trusted
# local use only). Tools declare the scope they require.
AGENTKIT_SCOPES=
# Human-held approval token required (per call) for destructive tools. The model never has it.
# Unset means every destructive call is denied.
AGENTKIT_APPROVAL_TOKEN=
# File path for the JSON Lines audit trail. Unset keeps the trail in memory only.
AGENTKIT_AUDIT_LOG=
# Comma-separated YAML tool-pack files or directories. Default: the bundled packs/ directory.
AGENTKIT_PACKS=

# ─── Language models ─────────────────────────────────────────────────────────
# LiteLLM identifiers in provider/model form. default: the tool-calling analyst.
LLM_DEFAULT=groq/openai/gpt-oss-120b
# reasoning: planner and report synthesis.
LLM_REASONING=anthropic/claude-sonnet-4-6
# judge: evaluation and scoring.
LLM_JUDGE=anthropic/claude-haiku-4-5
# Models tried when a tier fails authentication. LLM_DEFAULT_FALLBACK covers any tier without
# its own entry.
LLM_DEFAULT_FALLBACK=
LLM_REASONING_FALLBACK=
LLM_JUDGE_FALLBACK=
# Retries for a rate-limited call, honouring the provider's wait time (default 3).
LLM_RATE_LIMIT_RETRIES=3
# Provider keys; only providers you reference need one. <PROVIDER>_API_KEYS (comma or whitespace
# separated) or extra <PROVIDER>_API_KEY_<suffix> variables are rotated round-robin;
# <PROVIDER>_KEY_SLOTS (for example "1,3") pins this deployment to a subset.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Self-hosted inference ───────────────────────────────────────────────────
# remote (default) uses the hosted tiers above; local sends every tier to LLM_LOCAL and needs no
# provider key.
INFERENCE_MODE=remote
# Local model in LiteLLM form. The prefix selects the wire protocol: ollama_chat/<model> uses
# /api/chat, ollama/<model> uses /api/generate.
LLM_LOCAL=ollama/llama3.3
# Base URL where that model runs, without a trailing /api. OLLAMA_HOST is accepted as an alias.
# Empty uses LiteLLM's default (http://localhost:11434).
LOCAL_LLM_ENDPOINT=
OLLAMA_HOST=
# Bearer token for that endpoint when it requires one (INFERENCE_TOKEN is accepted as an alias).
LOCAL_LLM_TOKEN=
INFERENCE_TOKEN=
# Retry once on the local model when a hosted call fails. Default false; degrading model quality
# should be an explicit choice.
LLM_FALLBACK_TO_LOCAL=false
# Generic remote inference endpoint and token used by shared configuration helpers.
LLM_ENDPOINT=
LLM_TOKEN=

# ─── Telemetry ───────────────────────────────────────────────────────────────
# One anonymous startup ping (service name, version, random install id). Disable with
# TELEMETRY_OPT_OUT=true or DO_NOT_TRACK=1.
TELEMETRY_OPT_OUT=false
DO_NOT_TRACK=
# Override the ping destination. Empty uses the project default.
TELEMETRY_URL=

# ─── Demos and research scripts (see requirements-demos.txt) ─────────────────
# Model used by the CrewAI demo.
CREWAI_LLM=
# Model used by the Claude Agent SDK demo for vision-capable steps.
LLM_VISION_PREMIUM=
# DSPy experiment: delay between calls in seconds, maximum tokens and retries.
DSPY_CALL_DELAY_SECONDS=
DSPY_MAX_TOKENS=
DSPY_NUM_RETRIES=

# ─── Frontend build (Vite) ───────────────────────────────────────────────────
# API base URL when the dashboard is hosted separately. Empty = same origin.
VITE_API_BASE_URL=
# Dev server proxy target (the dev server default is http://localhost:8000).
VITE_PROXY_TARGET=http://localhost:8005
